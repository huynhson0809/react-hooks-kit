{
  "name": "react-hookz-kit",
  "version": "1.0.0",
  "description": "Essential React hooks for everyday development. Zero dependencies. TypeScript-first. Tree-shakeable.",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "hooks",
    "typescript",
    "useDebounce",
    "useLocalStorage",
    "useMediaQuery",
    "useFetch",
    "useToggle",
    "useInterval",
    "useClickOutside",
    "usePrevious",
    "zero-dependency"
  ],
  "author": "huynhson0809",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/huynhson0809/react-hookz-kit"
  },
  "bugs": {
    "url": "https://github.com/huynhson0809/react-hookz-kit/issues"
  },
  "homepage": "https://github.com/huynhson0809/react-hookz-kit#readme",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "devDependencies": {
    "@testing-library/react": "^14.0.0",
    "@testing-library/jest-dom": "^6.0.0",
    "jsdom": "^22.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^7.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
